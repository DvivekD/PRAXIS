# Database (Supabase PostgreSQL via Prisma)
DATABASE_URL="postgresql://postgres:password@db.example.supabase.co:6543/postgres?sslmode=require"
DIRECT_URL="postgresql://postgres:password@aws-pooler.supabase.com:5432/postgres"

# Groq Cloud API Key (for LLM evaluations and roleplay fallback)
GROQ_API_KEY="gsk_..."

# Google Gemini Live API
# Get a free API key at Google AI Studio: https://aistudio.google.com
# Free tier is used for the Live API (Google may use free-tier data to improve products).
# Kept strictly server-side for minting ephemeral tokens; NEVER expose to client.
GEMINI_API_KEY=""
